# Maintainer: owarimono <navammd@gmail.com>
pkgname=greed-dm-git
pkgver=0.1.0.r53.gf73df62
pkgrel=1
pkgdesc='Dark download manager for HTTP, BitTorrent, Metalink and video pages'
arch=('x86_64')
url='https://github.com/domesticsilk/greed'
license=('GPL-2.0-only')
depends=('aria2' 'curl' 'json-c' 'hicolor-icon-theme' 'libice' 'libsm' 'libx11' 'libxext')
makedepends=('cmake' 'git' 'pkgconf')
optdepends=(
    'yt-dlp: resolve video pages'
    'ffmpeg: merge separate video and audio streams'
    'libnotify: desktop notifications on completion'
)
provides=('greed-dm')
conflicts=('greed-dm')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/greed"
    if git describe --tags --long --abbrev=7 >/dev/null 2>&1; then
        git describe --tags --long --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
    else
        local ver
        ver=$(sed -n 's/^#define GREED_VERSION "\(.*\)"/\1/p' src/version.h)
        printf '%s.r%s.g%s' "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
    fi
}

build() {
    cd "$srcdir/greed"
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build -j"$(nproc)"
}

check() {
    cd "$srcdir/greed"
    ctest --test-dir build --output-on-failure
}

package() {
    cd "$srcdir/greed"
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 packaging/greed.desktop "$pkgdir/usr/share/applications/greed.desktop"
    install -Dm644 packaging/greed.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/greed.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -d "$pkgdir/usr/share/greed"
    cp -a extension "$pkgdir/usr/share/greed/extension"
}
